{
  // ============================================================
  // 配置模板 —— 复制成 wrangler.local.jsonc 后填写（后者已被 .gitignore 排除）
  //   cp wrangler.example.jsonc wrangler.local.jsonc
  // 所有命令都要带上配置：pnpm run deploy / pnpm dev 会自动找 wrangler.local.jsonc
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmq",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "observability": { "enabled": true },

  // 静态资源（CSS/JS/图片/字体）随 Worker 一起发布：
  //   - /static/* 由 Cloudflare 边缘直接从 assets 分发，不占 Worker 脚本体积
  //   - 限额：20,000 个文件 / 单文件 25 MiB（免费版够用）
  //   - 换了前端素材后重跑 `pnpm admin:build` / `pnpm web:build`（`pnpm run deploy` 会自动做）
  //   - 走外部 CDN 时，再用 `pnpm cdn:sync` 上传并校验
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 前台入口需要注入公开站点配置，后台入口需要隐藏别名；其余静态文件由边缘直接分发。
    // 前台只认带 .html 的伪静态地址（无后缀的 /doc 之类不提供），列少了会先落 assets
    // 再回落到 Worker，多一次无谓的查找。
    "run_worker_first": [
      "/",
      "/index.html",
      "/doc.html",
      "/api.html",
      "/demo.html",
      "/result.html",
      "/chaorder.html",
      "/console",
      "/console/",
      "/console/index.html",
    ],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vmq",
      // ↓ 换成你自己创建出来的 id：wrangler d1 create vmq
      "database_id": "<your-database-id>",
    },
  ],

  // 每分钟：关单 / 释放金额占位 / 回调重试 / 清理孤儿占位
  "triggers": { "crons": ["* * * * *"] },

  // 后台入口别名 / 通讯密钥 / 站点配置 **不放这里**：
  //   · 后台别名：首次部署后访问 /setup 填，存进 config 表
  //   · 通讯密钥：/setup 随机生成，后台「系统设置」可查看
  //   · 想用环境变量强制指定别名（优先级更高）：wrangler secret put ADMIN_ALIAS
  "vars": {},

  // 仅在使用自有反向代理、且 Worker 收到的 Host 已被改写时才设置：
  //   "TRUST_PROXY": "1",
  //   "TRUSTED_HOSTS": "pay.example.com,admin.example.com"
  // 两项必须同时配置；默认不信任任何 X-Forwarded-*，防止伪造 Host 导致开放重定向。
  // 开启后必须阻止客户端绕过反代直连 Worker，否则转发头仍可被伪造。

  // 部署前必读：
  // 1) 监控端 App 固定请求 https://<host>/appPush，不支持明文降级。
  //    自定义域名走 Cloudflare 默认证书即可；Always Use HTTPS 可以正常开启。
  // 2) 绑定自定义域名：加 routes: [{ "pattern": "pay.example.com/*", "custom_domain": true }]
  // 3) 密钥类配置不要写在这里，用 `wrangler secret put`。
  // 4) 想防别人抢先初始化，部署后立刻设 SETUP_TOKEN，再用 /setup?token=… 打开。
}
